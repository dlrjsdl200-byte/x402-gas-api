# ── MGO Gas API environment variables ──
# Copy to .env for local runs. Production values live in Vercel project settings.

# Server port for local runs (default 3000)
PORT=3000

# USDC receiving wallet on Base. Must equal PAY_TO in api/index.js (0x665bab4c46a6ae3f755e71793e5685bc6c47dd7a).
WALLET_ADDRESS=0x665bab4c46a6ae3f755e71793e5685bc6c47dd7a

# Coinbase Developer Platform API key (x402 facilitator auth). https://portal.cdp.coinbase.com
# Without these the paid endpoints answer 503 instead of attempting payment.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Upstash Redis (REST). Vercel Marketplace integration injects KV_REST_API_URL/TOKEN automatically.
# Used for: access log + /stats, demo rate limit, shared CoinGecko price cache. Optional locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# /stats access key (send as x-stats-key header). Optional: /stats is 404 when unset.
STATS_KEY=

# Salt for hashing client IPs in the access log. Set to any random string in production.
LOG_SALT=
